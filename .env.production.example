# Copiar a .env en el servidor (chmod 600). NUNCA subirlo al repositorio. Todos los valores son OBLIGATORIOS salvo los marcados (opcional).
ENVIRONMENT=production
API_DOMAIN=api.tudominio.com

# --- Base de datos (PostgreSQL 16 administrado recomendado)
# La API usa el rol SIN privilegios `agenda_app` (RLS depende de que NO sea superusuario). Cambia su contraseña tras crear el esquema:
#   ALTER ROLE agenda_app PASSWORD '<larga-y-aleatoria>';
DATABASE_URL=postgresql+asyncpg://agenda_app:CAMBIAR@HOST:5432/agenda
# Usuario ADMINISTRADOR, solo para migraciones (crea tablas y roles). No lo uses en la API.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://ADMIN:CAMBIAR@HOST:5432/agenda
# Solo si usas --profile localdb:
POSTGRES_SUPERUSER_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- Secretos (genera cada uno de forma independiente)
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"   (varias separadas por coma = rotación)
FERNET_KEY=

# --- Frontend y URLs públicas (https obligatorio)
CORS_ORIGINS=https://app.tudominio.com
PUBLIC_BASE_URL=https://app.tudominio.com
API_PUBLIC_URL=https://api.tudominio.com
DOCS_ENABLED=false

# --- IA (Claude). Sin clave, el asistente de WhatsApp no responde. Modelo y costo: ver docs/OPERACION.md
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Correo para avisos (opcional; sin esto los avisos por correo fallan con aviso claro)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Ajustes (valores por defecto razonables)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
SUBSCRIPTION_GRACE_DAYS=0
