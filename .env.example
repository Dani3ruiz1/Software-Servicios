# Copiar a .env. NUNCA subir .env al repositorio.
ENVIRONMENT=development
POSTGRES_DB=agenda
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar_en_dev
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=cambiar_en_dev

# La API usa el rol sin BYPASSRLS creado en sql/rls.sql
DATABASE_URL=postgresql+asyncpg://agenda_app:agenda_app_dev@postgres:5432/agenda
# Alembic usa el superusuario (DDL)
MIGRATIONS_DATABASE_URL=postgresql+psycopg://postgres:cambiar_en_dev@postgres:5432/agenda
REDIS_URL=redis://redis:6379/0

# Generar: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-esto-por-un-secreto-largo
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
# Generar: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEFAULT_TIMEZONE=America/Bogota
LOGIN_MAX_ATTEMPTS=5

# --- Opcionales (valores por defecto entre paréntesis)
# DOCS_ENABLED=true            # /docs y /openapi.json (apagado por defecto en producción)
# DB_POOL_SIZE=10  DB_MAX_OVERFLOW=10  DB_STATEMENT_TIMEOUT_MS=30000
# PUBLIC_BASE_URL=http://localhost:3000   API_PUBLIC_URL=http://localhost:8000
# ANTHROPIC_API_KEY=           # asistente de IA de WhatsApp
# AI_MODEL=claude-opus-5-5     # claude-sonnet-5-5 o claude-haiku-5-5 cuestan menos: ver docs/OPERACION.md
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= SMTP_FROM=
